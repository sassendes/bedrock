+func buildPool(cas []NamedPEM) (*x509.CertPool, []byte, error) {
+	if len(cas) == 0 {
+		return nil, nil, errors.New("no database ca found")
+	}
+	pool := x509.NewCertPool()
+	var bundle bytes.Buffer
