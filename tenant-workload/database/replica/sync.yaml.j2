apiVersion: policies.kyverno.io/v1
kind: GeneratingPolicy
metadata:
  name: bedrock-replica-ca-sync-{{ replica }}
spec:
  webhookConfiguration:
    timeoutSeconds: 10
  evaluation:
    generateExisting:
      enabled: true
    synchronize:
      enabled: true
  matchConstraints:
    namespaceSelector:
      matchExpressions:
        - key: kubernetes.io/metadata.name
          operator: In
          values:
            - {{ source_ns }}
    resourceRules:
      - apiGroups: [""]
        apiVersions: [v1]
        operations: [CREATE, UPDATE]
        resources: [secrets]
        resourceNames: [{{ source }}-ca]
  variables:
    - name: caCrt
      expression: |-
        [
          {
            "apiVersion": dyn("v1"),
            "kind": dyn("Secret"),
            "metadata": dyn({
              "name": "{{ source }}-ca-crt"
            }),
            "type": dyn("Opaque"),
            "data": dyn({
              "ca.crt": object.data["ca.crt"]
            })
          }
        ]
  generate:
    - expression: generator.Apply("{{ replica }}", variables.caCrt)
---
apiVersion: policies.kyverno.io/v1
kind: GeneratingPolicy
metadata:
  name: bedrock-replica-secret-sync-{{ replica }}
spec:
  webhookConfiguration:
    timeoutSeconds: 10
  evaluation:
    generateExisting:
      enabled: true
    synchronize:
      enabled: true
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: [v1]
        operations: [CREATE, UPDATE]
        resources: [namespaces]
        resourceNames: [{{ replica }}]
  variables:
    - name: nsName
      expression: object.metadata.name
    - name: source
      expression: resource.Get("v1", "secrets", "{{ source_ns }}", "{{ source }}-replication")
  generate:
    - expression: generator.Apply(variables.nsName, [variables.source])
---
