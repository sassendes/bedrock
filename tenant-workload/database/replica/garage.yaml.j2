{% for ns in ro_keys | map(attribute='ns') | list | union([replica]) | unique %}
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: garage-init-{{ replica }}
  namespace: {{ ns }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: [{% for k in ro_keys if k.ns == ns %}"{{ k.bucket }}-backups-ro", {% endfor %}"{{ replica }}-backups"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: garage-init-{{ replica }}
  namespace: {{ ns }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: garage-init-{{ replica }}
subjects:
  - kind: ServiceAccount
    name: garage-init
    namespace: garage
---
{% endfor %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: garage-init-{{ replica }}
  namespace: garage
data:
  init.sh: |
    set -euo pipefail
    A="http://garage.garage.svc:3903/v2"
    R="{{ replica }}"
    api() { curl -fsS -H "Authorization: Bearer ${ADMIN_TOKEN}" -H "Content-Type: application/json" "$@"; }
    mint() {
      local name="$1" bid="$2" write="$3" secret="$4" ns="$5"
      for OLD in $(api "$A/ListKeys" | jq -r --arg n "$name" '.[] | select(.name == $n) | .id'); do
        api -X POST "$A/DeleteKey?id=$OLD" >/dev/null
      done
      local K KID KS
      K=$(api -X POST "$A/CreateKey" -d "{\"name\":\"$name\"}")
      KID=$(echo "$K" | jq -r '.accessKeyId')
      KS=$(echo "$K" | jq -r '.secretAccessKey')
      api -X POST "$A/AllowBucketKey" -d "{\"bucketId\":\"$bid\",\"accessKeyId\":\"$KID\",\"permissions\":{\"read\":true,\"write\":$write,\"owner\":false}}" >/dev/null
      kubectl -n "$ns" create secret generic "$secret" --from-literal=AWS_ACCESS_KEY_ID="$KID" --from-literal=AWS_SECRET_ACCESS_KEY="$KS"
    }
    if ! kubectl -n "$R" get secret "$R-backups" >/dev/null 2>&1; then
      INFO=$(api "$A/GetBucketInfo?globalAlias=$R-backups" 2>/dev/null || true)
      BID=$(echo "$INFO" | jq -r '.id // empty' 2>/dev/null || true)
      if [ -n "$BID" ] && [ "$(echo "$INFO" | jq -r '.objects // 0')" != "0" ]; then
        echo "bucket $R-backups already holds objects: it is another database's wal, names are never reused"
        exit 1
      fi
      if [ -z "$BID" ]; then
        BID=$(api -X POST "$A/CreateBucket" -d "{\"globalAlias\":\"$R-backups\"}" | jq -r '.id')
      fi
      mint "$R-backups" "$BID" true "$R-backups" "$R"
    fi
    for pair in {% for k in ro_keys %}{{ k.bucket }}:{{ k.ns }} {% endfor %}; do
      SRC=${pair%%:*}
      NS=${pair##*:}
      if kubectl -n "$NS" get secret "$SRC-backups-ro" >/dev/null 2>&1; then continue; fi
      SID=$(api "$A/GetBucketInfo?globalAlias=$SRC-backups" | jq -r '.id')
      if [ -z "$SID" ] || [ "$SID" = "null" ]; then echo "no bucket $SRC-backups"; exit 1; fi
      mint "$SRC-backups-ro-$NS" "$SID" false "$SRC-backups-ro" "$NS"
    done
---
apiVersion: batch/v1
kind: Job
metadata:
  name: garage-init-{{ replica }}
  namespace: garage
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app: garage-init
    spec:
      serviceAccountName: garage-init
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: init
          image: alpine/k8s:1.36.4@sha256:358ddfc2d6ff3f00dd461dbd79aaa6d6738709f225b8da0945bb63bd4dbc304e
          command: ["bash", "/script/init.sh"]
          env:
            - name: HOME
              value: /tmp
            - name: ADMIN_TOKEN
              valueFrom:
                secretKeyRef:
                  name: garage-secrets
                  key: admin_token
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: script
              mountPath: /script
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: script
          configMap:
            name: garage-init-{{ replica }}
        - name: tmp
          emptyDir: {}
