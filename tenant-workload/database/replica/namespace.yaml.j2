apiVersion: v1
kind: Namespace
metadata:
  name: {{ replica }}
  labels:
    bedrock.io/database: "true"
    bedrock.io/failover-scope: "true"
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: {{ replica }}
automountServiceAccountToken: false
